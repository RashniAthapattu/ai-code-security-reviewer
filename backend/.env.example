# Copy to .env and fill in. Never commit the real .env file.

# Needed only for AI explanations. Without it, /scan still works as a plain scanner.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the explanations (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: most findings sent to the AI per scan (default: 20)
# MAX_EXPLAINED_FINDINGS=20

# Optional: websites allowed to call the API, comma-separated
# (default: http://localhost:3000). Set to your deployed website address.
# ALLOWED_ORIGINS=http://localhost:3000

# Optional: protect a public demo. Limits are per visitor, per hour (0 = no limit).
# RATE_LIMIT_PER_HOUR=60
# AI_RATE_LIMIT_PER_HOUR=10
# Longest code (characters) that will be sent to the AI (default: 20000)
# AI_MAX_CODE_LENGTH=20000
